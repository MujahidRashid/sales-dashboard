{
  "name": "pk-fashion-sales-dashboard",
  "version": "1.0.0",
  "description": "Sales dashboard for Pakistani clothing brands",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm run dev",
    "build": "npm install && cd client && npm ci && npm run build",
    "start": "node server.js",
    "scrape": "node scrapers/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "cheerio": "^1.0.0-rc.12",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
